
<xml xmlns="https://developers.google.com/blockly/xml" collection="false">
  <variables>
    <variable id="v_target_trades">No of Trades</variable>
    <variable id="v_trade_counter">Current Trade Counter</variable>
    <variable id="v_stake">Stake</variable>
  </variables>

  <block type="trade" id="trade_block" x="0" y="0">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">1HZ100V</field>
    <field name="TRADETYPECAT_LIST">digits</field>
    <field name="TRADETYPE_LIST">matchesdiffers</field>
    <field name="TYPE_LIST">DIGITDIFF</field>
    <field name="CANDLEINTERVAL_LIST">60</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">FALSE</field>

    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_target">
        <field name="VAR" id="v_target_trades" variabletype="">No of Trades</field>
        <value name="VALUE">
          <block type="math_number" id="target_value">
            <field name="NUM">50</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_counter">
            <field name="VAR" id="v_trade_counter" variabletype="">Current Trade Counter</field>
            <value name="VALUE">
              <block type="math_number" id="counter_zero">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_stake">
                <field name="VAR" id="v_stake" variabletype="">Stake</field>
                <value name="VALUE">
                  <block type="math_number" id="stake_value">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <block type="math_number" id="duration_one">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="read_stake">
            <field name="VAR" id="v_stake" variabletype="">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="math_number" id="prediction_zero">
            <field name="NUM">0</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_block" x="0" y="450">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase_differs">
        <field name="PURCHASE_LIST">DIGITDIFF</field>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_block" x="0" y="600">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="increment_counter">
        <field name="VAR" id="v_trade_counter" variabletype="">Current Trade Counter</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="add_completed_trade">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get" id="read_counter">
                <field name="VAR" id="v_trade_counter" variabletype="">Current Trade Counter</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="increment_one">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="continue_batch">
            <value name="IF0">
              <block type="logic_compare" id="below_limit">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="variables_get" id="counter_for_limit">
                    <field name="VAR" id="v_trade_counter" variabletype="">Current Trade Counter</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="target_for_limit">
                    <field name="VAR" id="v_target_trades" variabletype="">No of Trades</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="trade_again" id="repeat_batch"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
